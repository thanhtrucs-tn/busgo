# ============================================================
# .env.production - File MẪU cấu hình cho môi trường production.
#
# ĐÂY KHÔNG PHẢI FILE CHỨA SECRET THẬT.
#  - Chỉ chứa giá trị placeholder an toàn, được phép commit lên Git.
#  - Khi triển khai thật, hãy thay các giá trị dưới đây bằng biến môi
#    trường thật trên máy chủ, hoặc tạo file cấu hình riêng (không commit).
#  - TUYỆT ĐỐI không dán mật khẩu / JWT secret thật vào file này.
#
# Cách dùng:
#   - Chạy local:      dùng file .env (đã nằm trong .gitignore).
#   - Chạy production: đặt NODE_ENV=production, backend sẽ đọc file này.
#       Windows:  set NODE_ENV=production && npm start
#       Linux:    NODE_ENV=production npm start
# ============================================================

NODE_ENV=production

# Cổng chạy API (mặc định 3000).
PORT=3000

# --- MySQL: điền thông tin database production của bạn ---
DB_HOST=your_database_host
DB_PORT=3306
DB_NAME=BusGo
DB_USER=your_database_user
DB_PASSWORD=your_database_password

# --- JWT: BẮT BUỘC thay bằng chuỗi bí mật dài, khó đoán ---
# Sinh chuỗi ngẫu nhiên:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_a_secure_secret
JWT_EXPIRES_IN=7d

# --- Google OAuth: client ID cho đăng nhập Google (nếu dùng) ---
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# --- Nguồn ứng dụng Flutter được phép gọi API / kết nối Socket.IO ---
# Ví dụ: https://your-client-domain.com (dấu * cho phép mọi nguồn, chỉ dùng khi thử).
CLIENT_URL=https://your-client-domain.com
