
NODE_ENV=production

PORT=3000

#  MySQL: điền thông tin database production của bạn 
DB_HOST=your_database_host
DB_PORT=3306
DB_NAME=BusGo
DB_USER=your_database_user
DB_PASSWORD=your_database_password

JWT_SECRET=replace_with_a_secure_secret
JWT_EXPIRES_IN=7d

#  Google OAuth: client ID cho đăng nhập Google (nếu dùng) 
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

#  Nguồn ứng dụng Flutter được phép gọi API / kết nối Socket.IO 
CLIENT_URL=https://your-client-domain.com

#  Ước lượng thời gian xe đến trạm (ETA cơ bản, không phải dữ liệu thật) 
AVG_BUS_SPEED_KMH=20
AVG_DWELL_MINUTES=0.5
BUS_STALE_SECONDS=300
