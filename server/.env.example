# File mẫu cấu hình môi trường.
# Sao chép file này thành ".env" và điền thông tin của bạn.
# Ví dụ:  cp .env.example .env   (Windows: copy .env.example .env)
#
# QUAN TRỌNG:
#  - KHÔNG đưa file .env lên GitHub (file này đã nằm trong .gitignore).
#  - JWT_SECRET phải là chuỗi dài, khó đoán, riêng của bạn.
#    KHÔNG dùng đúng chuỗi trong file ví dụ này khi chạy thật.

# Cổng chạy API (mặc định 3000 - khớp với lib/config/api_config.dart của Flutter).
PORT=3000

# Thông tin kết nối MySQL.
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=BusGo

# Khóa bí mật dùng để ký JWT (BẮT BUỘC phải có).
# Ví dụ sinh chuỗi ngẫu nhiên:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=thay_bang_chuoi_khoa_bi_mat_that_dai_kho_doan
# Thời gian token hợp lệ: 7d = 7 ngày (có thể dùng 1h, 30d, ...).
JWT_EXPIRES_IN=7d